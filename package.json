{
  "name": "node-space-worker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 5731",
    "build": "tsc -b && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "preview:cloudflare": "wrangler dev",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview --port 5732",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply note-space-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply note-space-db --remote",
    "db:reset:local": "node -e \"fs.rmSync('.wrangler/state/v3/d1', { recursive: true, force: true })\" && wrangler d1 migrations apply note-space-db --local",
    "db:wipe:local": "node -e \"fs.rmSync('.wrangler/state', { recursive: true, force: true })\"",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:pull": "drizzle-kit pull",
    "email:dev": "email dev --dir src/features/auth/emails"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@fontsource-variable/geist": "^5.2.9",
    "@hookform/resolvers": "^5.4.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.0",
    "@tanstack/react-start": "^1.168.14",
    "@tanstack/router-plugin": "^1.132.0",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "emoji-picker-react": "^4.19.1",
    "filepond": "^4.32.12",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "filepond-plugin-image-preview": "^4.6.12",
    "husky": "^9.1.7",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.545.0",
    "motion": "^13.1.0",
    "ogl": "^1.0.11",
    "radix-ui": "^1.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-email": "6.9.0",
    "react-filepond": "^7.1.3",
    "react-hook-form": "^7.81.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.2",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@react-email/ui": "6.9.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.7.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.100.0"
  },
  "pnpm": {
    "overrides": {
      "@tanstack/react-router": "1.168.10",
      "@tanstack/react-start": "1.167.16",
      "@tanstack/router-core": "1.168.9",
      "@tanstack/router-plugin": "1.167.12",
      "@tanstack/start-plugin-core": "1.167.17"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
